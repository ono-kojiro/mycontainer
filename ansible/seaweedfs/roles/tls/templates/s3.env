### common
S3_CONFIG_OPTION="--config=/etc/seaweedfs/s3-config.json"
S3_FILER_OPTION="-filer=localhost:8888"

### without TLS
#S3_CONFIG_OPTION=""
#S3_HTTP_PORT_OPTION="-port=8333"
#S3_HTTPS_PORT_OPTION=""
#S3_CERT_FILE_OPTION=""
#S3_KEY_FILE_OPTION=""
#S3_TLSVERIFYCLIENTCERT_OPTION=""

### with TLS
S3_HTTP_PORT_OPTION="-port=0"
S3_HTTPS_PORT_OPTION="-port.https=8333"
S3_CERT_FILE_OPTION="-cert.file=/etc/seaweedfs/certs/server.crt"
S3_KEY_FILE_OPTION="-key.file=/etc/seaweedfs/certs/server.key"
S3_TLSVERIFYCLIENTCERT_OPTION="-tlsVerifyClientCert=false"

